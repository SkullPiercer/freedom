# App settings
APP_TITLE=Freedom test task

# Database settings
# Use POSTGRES__HOST=localhost when running Alembic from the host machine.
POSTGRES__HOST=auth_database
POSTGRES__USER=postgres
POSTGRES__PASSWORD=change_me
POSTGRES__DB=auth
POSTGRES__PORT=5432

# Redis settings
REDIS__HOST=redis
REDIS__PORT=6379
REDIS__PASSWORD=change_me

# Login rate limit settings
LOGIN_RATE_LIMIT__IP_LIMIT=10
LOGIN_RATE_LIMIT__IP_WINDOW=10
LOGIN_RATE_LIMIT__EMAIL_IP_LIMIT=5
LOGIN_RATE_LIMIT__EMAIL_IP_WINDOW=10

# Cookie settings
COOKIE__SECURE=False
COOKIE__SAMESITE=lax

# JWT settings
JWT__SECRET_KEY=change_me
JWT__ALGORITHM=HS256
JWT__ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT__REFRESH_TOKEN_EXPIRE_MINUTES=43200

# RabbitMQ settings
RABBITMQ__HOST=rabbitmq
RABBITMQ__PORT=5672
RABBITMQ__USER=guest
RABBITMQ__PASSWORD=change_me
RABBITMQ__NOTES_QUEUE=notes_rpc
RABBITMQ__RPC_TIMEOUT_SECONDS=10
